# Blynk IoT Cloud Telemetry Integration Configuration
# Copy this file to .env and insert your real credentials.
# NOTE: Never commit your real .env file or authentication tokens to Git.

# Blynk Cloud Base URL (default: https://blynk.cloud)
BLYNK_BASE_URL=https://blynk.cloud

# Blynk Device Authentication Token (from your ESP32 Arduino firmware)
BLYNK_AUTH_TOKEN=YOUR_BLYNK_AUTH_TOKEN

# Polling interval in milliseconds (default: 2000 ms to respect Blynk API rate limits)
BLYNK_POLL_INTERVAL_MS=2000

# HTTP request timeout in milliseconds
BLYNK_REQUEST_TIMEOUT_MS=5000

# Telemetry stale threshold in milliseconds (default: 10000 ms / 10 s)
TELEMETRY_STALE_AFTER_MS=10000

# Rover Device Identifier for stored telemetry
ROVER_DEVICE_ID=esp32-rover-01

# SQLite database file path for persisting real hardware telemetry and events
DATABASE_PATH=host/data/telemetry.db

# Dashboard HTTP Server Port
PORT=8080
